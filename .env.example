# Copy to .env.local. Both values are in Supabase Dashboard > Project Settings > API Keys.
# The publishable key is safe to ship in the browser; never put the database
# password or a secret/service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
